#!/bin/bash
#PBS -N sdc_n50
#PBS -l select=1:ncpus=4
#PBS -l walltime=02:00:00
#PBS -q workq
#PBS -j oe
#PBS -V

cd $PBS_O_WORKDIR

source $HOME/miniconda3/bin/activate sdc_sim

echo "N=50 Scale-up Job started on $(hostname) at $(date)"
python -u sdc_scaleup_n50.py > sdc_n50.log 2>&1
echo "N=50 Scale-up Job completed at $(date)"
